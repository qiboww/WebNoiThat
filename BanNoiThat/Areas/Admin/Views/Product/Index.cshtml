@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="max-w-7xl mx-auto px-6 py-10">
    <partial name="_AdminNav" />

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div>
            <h1 class="font-headline text-3xl font-semibold text-primary">Quản lý sản phẩm</h1>
            <p class="text-on-surface-variant mt-1 text-sm">Danh sách các sản phẩm nội thất đang kinh doanh trong hệ thống.</p>
        </div>
        <div>
            <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="inline-flex items-center gap-2 bg-primary text-white hover:bg-primary-container px-5 py-2.5 rounded-full font-medium shadow-sm hover:shadow transition-all duration-200">
                <span class="material-symbols-outlined text-[20px]">add</span>
                <span>Thêm sản phẩm mới</span>
            </a>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-secondary-container/30 border-b border-outline-variant/20 text-on-surface-variant text-xs font-semibold uppercase tracking-wider">
                        <th class="py-4 px-6">Hình ảnh</th>
                        <th class="py-4 px-6">Tên sản phẩm</th>
                        <th class="py-4 px-6">Thể loại</th>
                        <th class="py-4 px-6 text-right">Giá bán</th>
                        <th class="py-4 px-6 text-center">Số lượng</th>
                        <th class="py-4 px-6">Chất liệu</th>
                        <th class="py-4 px-6 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody id="product-table-body" class="divide-y divide-outline-variant/20 text-sm">
                    <tr>
                        <td colspan="7" class="py-10 px-6 text-center text-on-surface-variant">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <div class="w-6 h-6 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>
                                <span>Đang tải danh sách sản phẩm...</span>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            loadProducts();
        });

        async function loadProducts() {
            const tableBody = document.getElementById("product-table-body");
            try {
                const response = await fetch("/api/products");
                if (!response.ok) throw new Error("Không thể tải danh sách sản phẩm.");

                const products = await response.json();

                if (products.length === 0) {
                    tableBody.innerHTML = `
                        <tr>
                            <td colspan="7" class="py-10 px-6 text-center text-on-surface-variant">
                                <span class="material-symbols-outlined text-4xl text-on-surface-variant/30 block mb-2">inventory_2</span>
                                Không có sản phẩm nào được tìm thấy.
                            </td>
                        </tr>
                    `;
                    return;
                }

                let html = "";
                products.forEach(item => {
                    const imgHtml = item.imageUrl
                        ? `<img src="${item.imageUrl}" alt="${item.name}" class="w-full h-full object-cover" />`
                        : `<span class="material-symbols-outlined text-on-surface-variant/40">image</span>`;

                    const formattedPrice = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.price);
                    
                    const stockHtml = item.stockQuantity > 0 
                        ? `<span class="text-green-600 font-medium">${item.stockQuantity}</span>` 
                        : `<span class="text-red-500 font-medium">Hết hàng</span>`;

                    const categoryName = item.category ? item.category.name : "N/A";

                    html += `
                        <tr id="product-row-${item.productId}" class="hover:bg-surface-variant/10 transition-colors">
                            <td class="py-4 px-6">
                                <div class="w-14 h-14 rounded-lg overflow-hidden bg-surface-variant/20 border border-outline-variant/30 flex items-center justify-center">
                                    ${imgHtml}
                                </div>
                            </td>
                            <td class="py-4 px-6 font-medium text-on-surface">${item.name}</td>
                            <td class="py-4 px-6">
                                <span class="bg-secondary-container text-primary text-xs px-2.5 py-1 rounded-full font-medium">
                                    ${categoryName}
                                </span>
                            </td>
                            <td class="py-4 px-6 text-right font-semibold text-primary">${formattedPrice}</td>
                            <td class="py-4 px-6 text-center">${stockHtml}</td>
                            <td class="py-4 px-6 text-on-surface-variant">${item.material || "Đang cập nhật"}</td>
                            <td class="py-4 px-6">
                                <div class="flex items-center justify-center gap-3">
                                    <a href="/Admin/Product/Details/${item.productId}" class="text-on-surface-variant hover:text-primary p-1 rounded hover:bg-surface-variant/20 transition-colors" title="Xem chi tiết">
                                        <span class="material-symbols-outlined text-[20px]">visibility</span>
                                    </a>
                                    <a href="/Admin/Product/Edit/${item.productId}" class="text-primary hover:text-primary-container p-1 rounded hover:bg-surface-variant/20 transition-colors" title="Sửa">
                                        <span class="material-symbols-outlined text-[20px]">edit</span>
                                    </a>
                                    <button onclick="deleteProduct(${item.productId}, '${item.name}')" class="text-red-600 hover:text-red-500 p-1 rounded hover:bg-red-50 transition-colors cursor-pointer" title="Xóa">
                                        <span class="material-symbols-outlined text-[20px]">delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                });
                tableBody.innerHTML = html;
            } catch (error) {
                console.error("Lỗi tải sản phẩm:", error);
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="7" class="py-10 px-6 text-center text-red-500 font-medium">
                            Đã xảy ra lỗi khi tải dữ liệu sản phẩm: ${error.message}
                        </td>
                    </tr>
                `;
            }
        }

        async function deleteProduct(id, name) {
            if (!confirm(`Bạn có chắc chắn muốn xóa sản phẩm "${name}" không?`)) {
                return;
            }

            try {
                const response = await fetch(`/api/products/${id}`, {
                    method: "DELETE"
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    alert("Xóa sản phẩm thành công!");
                    const row = document.getElementById(`product-row-${id}`);
                    if (row) row.remove();
                    
                    const tableBody = document.getElementById("product-table-body");
                    if (tableBody.children.length === 0) {
                        loadProducts();
                    }
                } else {
                    alert(`Không thể xóa: ${result.message || "Lỗi không xác định."}`);
                }
            } catch (error) {
                console.error("Lỗi khi xóa sản phẩm:", error);
                alert("Đã xảy ra lỗi hệ thống khi xóa sản phẩm!");
            }
        }
    </script>
}