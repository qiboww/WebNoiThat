@{
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<div class="max-w-3xl mx-auto px-6 py-10">
    <div class="mb-8">
        <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="inline-flex items-center gap-1.5 text-on-surface-variant hover:text-primary transition-colors text-sm font-medium mb-4">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Quay lại danh sách</span>
        </a>
        <h1 class="font-headline text-3xl font-semibold text-primary">Thêm sản phẩm mới</h1>
        <p class="text-on-surface-variant mt-1 text-sm">Điền thông tin chi tiết bên dưới để thêm sản phẩm mới vào cửa hàng.</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-6 md:p-8">
        <form id="create-product-form" class="space-y-6" novalidate>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Tên sản phẩm -->
                <div class="md:col-span-2">
                    <label for="Name" class="block text-sm font-medium text-on-surface mb-2">Tên sản phẩm <span class="text-red-500">*</span></label>
                    <input id="Name" name="Name" type="text" placeholder="Ví dụ: Bàn ăn gỗ sồi Helsinki" class="w-full px-4 py-2.5 rounded-lg border border-outline-variant focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 text-sm transition-all" required />
                    <span id="error-Name" class="error-msg text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Danh mục sản phẩm -->
                <div>
                    <label for="CategoryId" class="block text-sm font-medium text-on-surface mb-2">Danh mục <span class="text-red-500">*</span></label>
                    <select id="CategoryId" name="CategoryId" class="w-full px-4 py-2.5 rounded-lg border border-outline-variant focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 text-sm bg-white transition-all" required>
                        <option value="">-- Đang tải danh mục... --</option>
                    </select>
                    <span id="error-CategoryId" class="error-msg text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Chất liệu -->
                <div>
                    <label for="Material" class="block text-sm font-medium text-on-surface mb-2">Chất liệu <span class="text-red-500">*</span></label>
                    <input id="Material" name="Material" type="text" placeholder="Ví dụ: Gỗ sồi tự nhiên" class="w-full px-4 py-2.5 rounded-lg border border-outline-variant focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 text-sm transition-all" required />
                    <span id="error-Material" class="error-msg text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Giá bán -->
                <div>
                    <label for="Price" class="block text-sm font-medium text-on-surface mb-2">Giá bán (₫) <span class="text-red-500">*</span></label>
                    <input id="Price" name="Price" type="number" min="0" step="any" placeholder="Ví dụ: 12500000" class="w-full px-4 py-2.5 rounded-lg border border-outline-variant focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 text-sm transition-all" required />
                    <span id="error-Price" class="error-msg text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Số lượng tồn -->
                <div>
                    <label for="StockQuantity" class="block text-sm font-medium text-on-surface mb-2">Số lượng kho <span class="text-red-500">*</span></label>
                    <input id="StockQuantity" name="StockQuantity" type="number" min="0" placeholder="Ví dụ: 10" class="w-full px-4 py-2.5 rounded-lg border border-outline-variant focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 text-sm transition-all" required />
                    <span id="error-StockQuantity" class="error-msg text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Tải lên hình ảnh -->
                <div class="md:col-span-2">
                    <label for="imageFile" class="block text-sm font-medium text-on-surface mb-2">Hình ảnh sản phẩm</label>
                    <input id="imageFile" name="imageFile" type="file" accept="image/*" class="w-full px-4 py-2 rounded-lg border border-outline-variant focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 text-sm bg-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-primary/10 file:text-primary hover:file:bg-primary/20 transition-all cursor-pointer" />
                    <p class="text-xs text-on-surface-variant mt-1">Chọn một file ảnh từ máy tính để tải lên hệ thống.</p>
                    <span id="error-imageFile" class="error-msg text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Tải lên mô hình 3D -->
                <div class="md:col-span-2">
                    <label for="model3dFile" class="block text-sm font-medium text-on-surface mb-2">Mô hình 3D sản phẩm (.glb)</label>
                    <input id="model3dFile" name="model3dFile" type="file" accept=".glb" class="w-full px-4 py-2 rounded-lg border border-outline-variant focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 text-sm bg-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-primary/10 file:text-primary hover:file:bg-primary/20 transition-all cursor-pointer" />
                    <p class="text-xs text-on-surface-variant mt-1">Chọn một tệp tin mô hình 3D định dạng .glb để hiển thị tương tác 3D.</p>
                    <span id="error-model3dFile" class="error-msg text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Mô tả sản phẩm -->
                <div class="md:col-span-2">
                    <label for="Description" class="block text-sm font-medium text-on-surface mb-2">Mô tả sản phẩm</label>
                    <textarea id="Description" name="Description" rows="4" placeholder="Nhập mô tả chi tiết sản phẩm tại đây..." class="w-full px-4 py-2.5 rounded-lg border border-outline-variant focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 text-sm transition-all resize-y"></textarea>
                    <span id="error-Description" class="error-msg text-red-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <!-- Các nút hành động -->
            <div class="flex items-center justify-end gap-4 pt-4 border-t border-outline-variant/30">
                <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="px-5 py-2.5 rounded-full border border-outline-variant hover:bg-surface-variant/25 font-medium text-sm text-on-surface transition-all">
                    Hủy bỏ
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-full bg-primary hover:bg-primary-container text-white font-medium text-sm shadow-sm hover:shadow transition-all">
                    Lưu sản phẩm
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            loadCategories();
        });

        async function loadCategories() {
            const selectEl = document.getElementById("CategoryId");
            try {
                const response = await fetch("/api/categories");
                if (!response.ok) throw new Error("Lỗi tải danh mục.");
                
                const categories = await response.json();
                
                let html = '<option value="">-- Chọn danh mục --</option>';
                categories.forEach(cat => {
                    html += `<option value="${cat.categoryId}">${cat.name}</option>`;
                });
                
                selectEl.innerHTML = html;
            } catch (error) {
                console.error(error);
                selectEl.innerHTML = '<option value="">-- Lỗi tải danh mục --</option>';
            }
        }

        document.getElementById("create-product-form").addEventListener("submit", async function (e) {
            e.preventDefault();

            // Clear validation errors
            document.querySelectorAll(".error-msg").forEach(el => el.textContent = "");

            const form = e.target;
            const formData = new FormData(form);

            // Simple client check
            if (!document.getElementById("Name").value.trim()) {
                document.getElementById("error-Name").textContent = "Tên sản phẩm là bắt buộc.";
                return;
            }
            if (!document.getElementById("CategoryId").value) {
                document.getElementById("error-CategoryId").textContent = "Vui lòng chọn danh mục.";
                return;
            }
            if (!document.getElementById("Price").value || parseFloat(document.getElementById("Price").value) < 0) {
                document.getElementById("error-Price").textContent = "Giá bán hợp lệ là bắt buộc.";
                return;
            }

            try {
                const response = await fetch("/api/products", {
                    method: "POST",
                    body: formData
                });

                if (response.ok) {
                    alert("Thêm sản phẩm mới thành công!");
                    window.location.href = "/Admin/Product";
                } else if (response.status === 400) {
                    const errData = await response.json();
                    if (errData.errors) {
                        for (const [key, messages] of Object.entries(errData.errors)) {
                            const errorSpan = document.getElementById(`error-${key}`);
                            if (errorSpan) {
                                errorSpan.textContent = messages.join(", ");
                            }
                        }
                    } else {
                        alert(errData.message || "Dữ liệu gửi lên không hợp lệ.");
                    }
                } else if (response.status === 401 || response.status === 403) {
                    alert("Bạn không có quyền thực hiện thao tác này. Vui lòng đăng nhập lại với tài khoản Admin.");
                } else {
                    const errText = await response.text();
                    alert("Lỗi hệ thống: " + (errText || response.statusText));
                }
            } catch (error) {
                console.error("Lỗi khi tạo sản phẩm:", error);
                alert("Đã xảy ra lỗi hệ thống khi kết nối tới máy chủ.");
            }
        });
    </script>
}
