@{
    ViewData["Title"] = "Chi tiết người dùng";
}

<div class="max-w-3xl mx-auto px-6 py-10">
    <div class="mb-8">
        <a asp-area="Admin" asp-controller="User" asp-action="Index" class="inline-flex items-center gap-1.5 text-on-surface-variant hover:text-primary transition-colors text-sm font-medium mb-4">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Quay lại danh sách</span>
        </a>
        <h1 class="font-headline text-3xl font-semibold text-primary">Chi tiết tài khoản người dùng</h1>
        <p class="text-on-surface-variant mt-1 text-sm">Xem đầy đủ thông tin chi tiết và trạng thái bảo mật của tài khoản.</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-6 md:p-8">
        <div id="loading-spinner" class="flex flex-col items-center justify-center py-12 gap-2 text-on-surface-variant">
            <div class="w-8 h-8 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>
            <span>Đang tải thông tin chi tiết...</span>
        </div>

        <div id="user-details-card" class="space-y-6 hidden">
            <!-- Thông tin chính -->
            <div class="border-b border-outline-variant/20 pb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 rounded-full bg-primary/10 text-primary border border-primary/20 flex items-center justify-center shadow-inner">
                        <span class="material-symbols-outlined text-[36px]">account_circle</span>
                    </div>
                    <div>
                        <h2 id="detail-email" class="font-semibold text-xl text-primary">example@webnoithat.com</h2>
                        <p id="detail-id" class="text-xs text-on-surface-variant mt-1 font-mono">ID: ...</p>
                    </div>
                </div>
                <div id="detail-status">
                    <!-- Trạng thái (Hoạt động / Khóa) -->
                </div>
            </div>

            <!-- Các thuộc tính -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 py-2">
                <div>
                    <span class="block text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Số điện thoại liên hệ</span>
                    <span id="detail-phone" class="block text-base text-on-surface font-medium mt-1">Chưa cập nhật</span>
                </div>
                <div>
                    <span class="block text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Vai trò truy cập (Roles)</span>
                    <div id="detail-roles" class="flex flex-wrap gap-1.5 mt-1.5">
                        <!-- Roles list -->
                    </div>
                </div>
            </div>

            <!-- Nút hành động -->
            <div class="flex items-center justify-end gap-4 pt-6 border-t border-outline-variant/30">
                <a id="btn-edit-user" href="#" class="px-6 py-2.5 rounded-full bg-primary hover:bg-primary-container text-white font-medium text-sm shadow-sm hover:shadow transition-all flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">edit</span>
                    <span>Chỉnh sửa tài khoản</span>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const userId = "@ViewBag.UserId";

        document.addEventListener("DOMContentLoaded", function () {
            loadUserDetails();
        });

        async function loadUserDetails() {
            try {
                const response = await fetch(`/api/users/${userId}`);
                if (!response.ok) throw new Error("Không thể tải thông tin chi tiết người dùng.");
                const user = await response.json();

                // Gán dữ liệu vào UI
                document.getElementById("detail-email").textContent = user.email || "";
                document.getElementById("detail-id").textContent = `ID: ${user.id}`;
                document.getElementById("detail-phone").textContent = user.phoneNumber || "Chưa cập nhật";
                document.getElementById("btn-edit-user").href = `/Admin/User/Edit/${user.id}`;

                // Trạng thái badge
                const statusContainer = document.getElementById("detail-status");
                if (user.isLockedOut) {
                    statusContainer.innerHTML = `
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 text-sm font-semibold rounded-full bg-red-50 text-red-700 border border-red-200">
                            <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
                            Tài khoản bị khóa
                        </span>
                    `;
                } else {
                    statusContainer.innerHTML = `
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 text-sm font-semibold rounded-full bg-green-50 text-green-700 border border-green-200">
                            <span class="w-2 h-2 rounded-full bg-green-600"></span>
                            Đang hoạt động
                        </span>
                    `;
                }

                // Roles badge list
                const rolesContainer = document.getElementById("detail-roles");
                if (user.roles && user.roles.length > 0) {
                    let rolesHtml = "";
                    user.roles.forEach(role => {
                        const badgeColor = role === "Admin" 
                            ? "bg-primary/10 text-primary border-primary/20" 
                            : "bg-secondary-container/50 text-on-surface-variant border-outline-variant/30";
                        rolesHtml += `<span class="inline-block px-3 py-1 text-sm font-semibold rounded-full border ${badgeColor}">${role}</span>`;
                    });
                    rolesContainer.innerHTML = rolesHtml;
                } else {
                    rolesContainer.innerHTML = `<span class="text-sm text-on-surface-variant italic">Không có vai trò</span>`;
                }

                // Ẩn spinner và hiển thị thẻ thông tin
                document.getElementById("loading-spinner").classList.add("hidden");
                document.getElementById("user-details-card").classList.remove("hidden");
            } catch (error) {
                console.error("Lỗi khi tải chi tiết người dùng:", error);
                document.getElementById("loading-spinner").innerHTML = `
                    <span class="text-red-500 font-semibold text-center">
                        Đã có lỗi xảy ra: ${error.message}
                    </span>
                `;
            }
        }
    </script>
}
