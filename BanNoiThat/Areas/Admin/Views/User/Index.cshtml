@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="max-w-7xl mx-auto px-6 py-10">
    <partial name="_AdminNav" />

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div>
            <h1 class="font-headline text-3xl font-semibold text-primary">Quản lý người dùng</h1>
            <p class="text-on-surface-variant mt-1 text-sm">Danh sách tài khoản người dùng và vai trò truy cập hệ thống.</p>
        </div>
        <div>
            <a asp-area="Admin" asp-controller="User" asp-action="Create" class="inline-flex items-center gap-2 bg-primary text-white hover:bg-primary-container px-5 py-2.5 rounded-full font-medium shadow-sm hover:shadow transition-all duration-200">
                <span class="material-symbols-outlined text-[20px]">add</span>
                <span>Thêm người dùng mới</span>
            </a>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-secondary-container/30 border-b border-outline-variant/20 text-on-surface-variant text-xs font-semibold uppercase tracking-wider">
                        <th class="py-4 px-6">Email / Username</th>
                        <th class="py-4 px-6">Số điện thoại</th>
                        <th class="py-4 px-6">Vai trò (Roles)</th>
                        <th class="py-4 px-6">Trạng thái</th>
                        <th class="py-4 px-6 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody id="user-table-body" class="divide-y divide-outline-variant/20 text-sm">
                    <tr>
                        <td colspan="5" class="py-10 px-6 text-center text-on-surface-variant">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <div class="w-6 h-6 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>
                                <span>Đang tải danh sách người dùng...</span>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            loadUsers();
        });

        async function loadUsers() {
            const tableBody = document.getElementById("user-table-body");
            try {
                const response = await fetch("/api/users");
                if (!response.ok) throw new Error("Không thể tải danh sách người dùng.");
                
                const users = await response.json();
                
                if (users.length === 0) {
                    tableBody.innerHTML = `
                        <tr>
                            <td colspan="5" class="py-10 px-6 text-center text-on-surface-variant">
                                Chưa có người dùng nào trong hệ thống.
                            </td>
                        </tr>
                    `;
                    return;
                }

                let html = "";
                users.forEach(user => {
                    // Badge roles
                    let roleBadges = "";
                    if (user.roles && user.roles.length > 0) {
                        user.roles.forEach(role => {
                            const badgeColor = role === "Admin" 
                                ? "bg-primary/10 text-primary border-primary/20" 
                                : "bg-secondary-container/50 text-on-surface-variant border-outline-variant/30";
                            roleBadges += `<span class="inline-block px-2.5 py-0.5 text-xs font-semibold rounded-full border ${badgeColor} mr-1">${role}</span>`;
                        });
                    } else {
                        roleBadges = `<span class="text-xs text-on-surface-variant italic">Chưa phân vai trò</span>`;
                    }

                    // Status badge
                    const statusBadge = user.isLockedOut 
                        ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 text-xs font-semibold rounded-full bg-red-50 text-red-700 border border-red-200">
                             <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>
                             Đã bị khóa
                           </span>`
                        : `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 text-xs font-semibold rounded-full bg-green-50 text-green-700 border border-green-200">
                             <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                             Hoạt động
                           </span>`;

                    // Lock button text / icon
                    const lockIcon = user.isLockedOut ? "lock_open" : "lock";
                    const lockTitle = user.isLockedOut ? "Mở khóa tài khoản" : "Khóa tài khoản";
                    const lockColor = user.isLockedOut ? "text-green-600 hover:text-green-500 hover:bg-green-50" : "text-amber-600 hover:text-amber-500 hover:bg-amber-50";

                    html += `
                        <tr id="user-row-${user.id}" class="hover:bg-surface-variant/10 transition-colors">
                            <td class="py-4 px-6 font-semibold text-primary text-base">${user.email}</td>
                            <td class="py-4 px-6 text-on-surface-variant font-medium">${user.phoneNumber || '<span class="text-xs italic text-outline-variant">Chưa cập nhật</span>'}</td>
                            <td class="py-4 px-6">${roleBadges}</td>
                            <td class="py-4 px-6">${statusBadge}</td>
                            <td class="py-4 px-6">
                                <div class="flex items-center justify-center gap-3">
                                    <a href="/Admin/User/Details/${user.id}" class="text-on-surface-variant hover:text-primary p-1 rounded hover:bg-surface-variant/20 transition-colors" title="Xem chi tiết">
                                        <span class="material-symbols-outlined text-[20px]">visibility</span>
                                    </a>
                                    <a href="/Admin/User/Edit/${user.id}" class="text-primary hover:text-primary-container p-1 rounded hover:bg-surface-variant/20 transition-colors" title="Sửa">
                                        <span class="material-symbols-outlined text-[20px]">edit</span>
                                    </a>
                                    <button onclick="toggleLock('${user.id}', '${user.email}', ${user.isLockedOut})" class="${lockColor} p-1 rounded transition-colors cursor-pointer" title="${lockTitle}">
                                        <span class="material-symbols-outlined text-[20px]">${lockIcon}</span>
                                    </button>
                                    <button onclick="deleteUser('${user.id}', '${user.email}')" class="text-red-600 hover:text-red-500 p-1 rounded hover:bg-red-50 transition-colors cursor-pointer" title="Xóa">
                                        <span class="material-symbols-outlined text-[20px]">delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                });
                tableBody.innerHTML = html;
            } catch (error) {
                console.error(error);
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="5" class="py-10 px-6 text-center text-red-500 font-medium">
                            Đã xảy ra lỗi khi tải dữ liệu: ${error.message}
                        </td>
                    </tr>
                `;
            }
        }

        async function toggleLock(id, email, isLocked) {
            const actionText = isLocked ? "mở khóa" : "khóa";
            if (!confirm(`Bạn có chắc chắn muốn ${actionText} tài khoản "${email}" không?`)) {
                return;
            }

            try {
                const response = await fetch(`/api/users/${id}/toggle-lock`, {
                    method: "POST"
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    alert(`${isLocked ? "Mở khóa" : "Khóa"} tài khoản thành công!`);
                    loadUsers(); // Tải lại danh sách
                } else {
                    alert(`Không thể thực hiện hành động: ${result.message || "Lỗi không xác định."}`);
                }
            } catch (error) {
                console.error("Lỗi khi thay đổi trạng thái khóa:", error);
                alert("Đã xảy ra lỗi hệ thống!");
            }
        }

        async function deleteUser(id, email) {
            if (!confirm(`Bạn có chắc chắn muốn xóa tài khoản "${email}"? Hành động này không thể hoàn tác!`)) {
                return;
            }

            try {
                const response = await fetch(`/api/users/${id}`, {
                    method: "DELETE"
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    alert("Xóa người dùng thành công!");
                    const row = document.getElementById(`user-row-${id}`);
                    if (row) row.remove();
                } else {
                    alert(`Không thể xóa: ${result.message || "Lỗi không xác định."}`);
                }
            } catch (error) {
                console.error("Lỗi khi xóa người dùng:", error);
                alert("Đã xảy ra lỗi hệ thống khi xóa người dùng!");
            }
        }
    </script>
}
