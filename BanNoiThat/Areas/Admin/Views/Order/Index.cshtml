@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="max-w-7xl mx-auto px-6 py-10">
    <partial name="_AdminNav" />

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div>
            <h1 class="font-headline text-3xl font-semibold text-primary">Quản lý đơn hàng</h1>
            <p class="text-on-surface-variant mt-1 text-sm">Xem và xử lý các đơn hàng của khách hàng trong hệ thống.</p>
        </div>
    </div>

    <!-- Bộ lọc & Tìm kiếm -->
    <div class="flex flex-col md:flex-row gap-4 mb-6">
        <div class="flex-1 relative">
            <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant/60 text-[20px]">search</span>
            <input type="text" id="order-search" placeholder="Tìm kiếm theo email khách hàng, số điện thoại, địa chỉ..." 
                   class="w-full pl-10 pr-4 py-2 border border-outline-variant/30 rounded-lg text-sm bg-white focus:outline-none focus:border-primary transition-colors" />
        </div>
        <div class="w-full md:w-56">
            <select id="order-filter-status" 
                    class="w-full px-3 py-2 border border-outline-variant/30 rounded-lg text-sm bg-white focus:outline-none focus:border-primary transition-colors">
                <option value="">Tất cả trạng thái</option>
                <option value="Pending">Chờ xử lý (Pending)</option>
                <option value="Confirmed">Đã xác nhận (Confirmed)</option>
                <option value="Shipping">Đang giao hàng (Shipping)</option>
                <option value="Completed">Hoàn thành (Completed)</option>
                <option value="Cancelled">Đã hủy (Cancelled)</option>
            </select>
        </div>
    </div>

    <!-- Bảng đơn hàng -->
    <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-secondary-container/30 border-b border-outline-variant/20 text-on-surface-variant text-xs font-semibold uppercase tracking-wider">
                        <th class="py-4 px-6">ID</th>
                        <th class="py-4 px-6">Khách hàng</th>
                        <th class="py-4 px-6">Ngày đặt</th>
                        <th class="py-4 px-6 text-right">Tổng tiền</th>
                        <th class="py-4 px-6">Số điện thoại</th>
                        <th class="py-4 px-6 text-center">Trạng thái</th>
                        <th class="py-4 px-6 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody id="order-table-body" class="divide-y divide-outline-variant/20 text-sm">
                    <tr>
                        <td colspan="7" class="py-10 px-6 text-center text-on-surface-variant">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <div class="w-6 h-6 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>
                                <span>Đang tải danh sách đơn hàng...</span>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let allOrders = [];

        document.addEventListener("DOMContentLoaded", function () {
            loadOrders();

            // Lắng nghe sự kiện tìm kiếm và lọc
            document.getElementById("order-search").addEventListener("input", filterOrders);
            document.getElementById("order-filter-status").addEventListener("change", filterOrders);
        });

        async function loadOrders() {
            const tableBody = document.getElementById("order-table-body");
            try {
                const response = await fetch("/api/admin/orders");
                if (!response.ok) throw new Error("Không thể tải danh sách đơn hàng.");

                allOrders = await response.json();
                renderOrders(allOrders);
            } catch (error) {
                console.error("Lỗi tải đơn hàng:", error);
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="7" class="py-10 px-6 text-center text-red-500 font-medium">
                            Đã xảy ra lỗi khi tải dữ liệu đơn hàng: ${error.message}
                        </td>
                    </tr>
                `;
            }
        }

        function getStatusBadge(status) {
            switch (status) {
                case "Pending":
                    return `<span class="inline-flex items-center bg-yellow-50 text-yellow-800 border border-yellow-200 text-xs px-2.5 py-1 rounded-full font-medium">Chờ xử lý</span>`;
                case "Confirmed":
                    return `<span class="inline-flex items-center bg-blue-50 text-blue-800 border border-blue-200 text-xs px-2.5 py-1 rounded-full font-medium">Đã xác nhận</span>`;
                case "Shipping":
                    return `<span class="inline-flex items-center bg-indigo-50 text-indigo-800 border border-indigo-200 text-xs px-2.5 py-1 rounded-full font-medium">Đang giao</span>`;
                case "Completed":
                    return `<span class="inline-flex items-center bg-green-50 text-green-800 border border-green-200 text-xs px-2.5 py-1 rounded-full font-medium">Hoàn thành</span>`;
                case "Cancelled":
                    return `<span class="inline-flex items-center bg-red-50 text-red-800 border border-red-200 text-xs px-2.5 py-1 rounded-full font-medium">Đã hủy</span>`;
                default:
                    return `<span class="inline-flex items-center bg-gray-50 text-gray-800 border border-gray-200 text-xs px-2.5 py-1 rounded-full font-medium">${status}</span>`;
            }
        }

        function renderOrders(ordersList) {
            const tableBody = document.getElementById("order-table-body");
            
            if (ordersList.length === 0) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="7" class="py-10 px-6 text-center text-on-surface-variant">
                            <span class="material-symbols-outlined text-4xl text-on-surface-variant/30 block mb-2">shopping_bag</span>
                            Không tìm thấy đơn hàng nào.
                        </td>
                    </tr>
                `;
                return;
            }

            let html = "";
            ordersList.forEach(item => {
                const formattedPrice = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.totalAmount);
                const orderDate = new Date(item.orderDate).toLocaleString('vi-VN');

                html += `
                    <tr id="order-row-${item.orderId}" class="hover:bg-surface-variant/10 transition-colors">
                        <td class="py-4 px-6 text-on-surface-variant font-medium">#${item.orderId}</td>
                        <td class="py-4 px-6 font-medium text-on-surface">
                            <div class="flex flex-col">
                                <span class="font-semibold text-primary">${item.userEmail || "Khách vãng lai"}</span>
                                <span class="text-xs text-on-surface-variant/75 max-w-[200px] truncate" title="${item.shippingAddress}">${item.shippingAddress}</span>
                            </div>
                        </td>
                        <td class="py-4 px-6 text-on-surface-variant">${orderDate}</td>
                        <td class="py-4 px-6 text-right font-semibold text-primary">${formattedPrice}</td>
                        <td class="py-4 px-6 text-on-surface-variant">${item.phoneNumber}</td>
                        <td class="py-4 px-6 text-center">${getStatusBadge(item.status)}</td>
                        <td class="py-4 px-6">
                            <div class="flex items-center justify-center gap-3">
                                <a href="/Admin/Order/Details/${item.orderId}" class="text-on-surface-variant hover:text-primary p-1 rounded hover:bg-surface-variant/20 transition-colors" title="Chi tiết & Xử lý">
                                    <span class="material-symbols-outlined text-[20px]">visibility</span>
                                </a>
                                <button onclick="deleteOrder(${item.orderId})" class="text-red-600 hover:text-red-500 p-1 rounded hover:bg-red-50 transition-colors cursor-pointer" title="Xóa đơn hàng">
                                    <span class="material-symbols-outlined text-[20px]">delete</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });
            tableBody.innerHTML = html;
        }

        function filterOrders() {
            const searchQuery = document.getElementById("order-search").value.toLowerCase().trim();
            const statusFilter = document.getElementById("order-filter-status").value;

            const filtered = allOrders.filter(order => {
                const matchesSearch = 
                    (order.userEmail && order.userEmail.toLowerCase().includes(searchQuery)) ||
                    (order.phoneNumber && order.phoneNumber.includes(searchQuery)) ||
                    (order.shippingAddress && order.shippingAddress.toLowerCase().includes(searchQuery)) ||
                    order.orderId.toString().includes(searchQuery);

                const matchesStatus = statusFilter === "" || order.status === statusFilter;

                return matchesSearch && matchesStatus;
            });

            renderOrders(filtered);
        }

        async function deleteOrder(id) {
            if (!confirm(`Bạn có chắc chắn muốn xóa đơn hàng #${id} không? Hành động này sẽ xóa vĩnh viễn đơn hàng khỏi cơ sở dữ liệu.`)) {
                return;
            }

            try {
                const response = await fetch(`/api/admin/orders/${id}`, {
                    method: "DELETE"
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    alert("Xóa đơn hàng thành công!");
                    // Xóa dòng khỏi DOM
                    const row = document.getElementById(`order-row-${id}`);
                    if (row) row.remove();

                    // Cập nhật mảng dữ liệu local
                    allOrders = allOrders.filter(o => o.orderId !== id);
                    
                    const tableBody = document.getElementById("order-table-body");
                    if (tableBody.children.length === 0) {
                        loadOrders();
                    }
                } else {
                    alert(`Không thể xóa: ${result.message || "Lỗi không xác định."}`);
                }
            } catch (error) {
                console.error("Lỗi khi xóa đơn hàng:", error);
                alert("Đã xảy ra lỗi hệ thống khi xóa đơn hàng!");
            }
        }
    </script>
}
