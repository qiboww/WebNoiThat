@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var orderId = ViewBag.OrderId;
}

<div class="max-w-7xl mx-auto px-6 py-10">
    <!-- Nút quay lại và tiêu đề -->
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="inline-flex items-center gap-1.5 text-on-surface-variant hover:text-primary transition-colors text-sm font-medium mb-4">
                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                <span>Quay lại danh sách</span>
            </a>
            <h1 class="font-headline text-3xl font-semibold text-primary">Chi tiết đơn hàng #@orderId</h1>
        </div>
        <div id="action-buttons-container" class="flex items-center gap-3 hidden">
            <button id="btn-delete" class="inline-flex items-center gap-1.5 bg-red-600 text-white hover:bg-red-500 px-5 py-2.5 rounded-full font-medium transition-all text-sm shadow-sm hover:shadow cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">delete</span>
                <span>Xóa đơn hàng</span>
            </button>
        </div>
    </div>

    <!-- Loading spinner -->
    <div id="loading-container" class="py-20 text-center text-on-surface-variant">
        <div class="inline-block w-8 h-8 border-4 border-primary border-t-transparent rounded-full animate-spin mb-2"></div>
        <p>Đang tải chi tiết đơn hàng...</p>
    </div>

    <!-- Nội dung chi tiết đơn hàng -->
    <div id="order-details-content" class="grid grid-cols-1 lg:grid-cols-3 gap-8 hidden">
        <!-- Cột bên trái: Danh sách sản phẩm -->
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden p-6">
                <h3 class="font-headline text-lg font-semibold text-primary mb-4">Sản phẩm đã đặt</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="border-b border-outline-variant/20 text-on-surface-variant font-semibold bg-secondary-container/10">
                                <th class="py-4 px-6 whitespace-nowrap">Hình ảnh</th>
                                <th class="py-4 px-6 min-w-[200px]">Sản phẩm</th>
                                <th class="py-4 px-6 text-center whitespace-nowrap">Số lượng</th>
                                <th class="py-4 px-6 text-right whitespace-nowrap">Đơn giá</th>
                                <th class="py-4 px-6 text-right whitespace-nowrap">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody id="order-items-tbody" class="divide-y divide-outline-variant/20">
                            <!-- Đổ dữ liệu từ JS -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tổng kết tiền mặt -->
            <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-6 space-y-3">
                <div class="flex justify-between text-sm text-on-surface-variant">
                    <span>Tạm tính sản phẩm:</span>
                    <span id="subtotal-amount" class="font-medium text-on-surface">0₫</span>
                </div>
                <div class="flex justify-between text-sm text-on-surface-variant">
                    <span>Phí vận chuyển:</span>
                    <span id="shipping-fee" class="font-medium text-on-surface">0₫</span>
                </div>
                <div class="border-t border-outline-variant/25 pt-3 flex justify-between text-base font-bold text-primary">
                    <span>Tổng tiền thanh toán:</span>
                    <span id="total-amount" class="text-xl">0₫</span>
                </div>
            </div>
        </div>

        <!-- Cột bên phải: Thông tin giao hàng & Trạng thái -->
        <div class="space-y-6">
            <!-- Thông tin khách hàng & Giao hàng -->
            <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-6 space-y-4">
                <h3 class="font-headline text-lg font-semibold text-primary">Thông tin giao hàng</h3>
                
                <div>
                    <label class="text-xs text-on-surface-variant font-medium block uppercase tracking-wider">Khách hàng</label>
                    <div id="customer-email" class="text-on-surface font-semibold mt-1">Đang tải...</div>
                </div>

                <div>
                    <label class="text-xs text-on-surface-variant font-medium block uppercase tracking-wider">Số điện thoại</label>
                    <div id="customer-phone" class="text-on-surface font-semibold mt-1">Đang tải...</div>
                </div>

                <div>
                    <label class="text-xs text-on-surface-variant font-medium block uppercase tracking-wider">Địa chỉ giao hàng</label>
                    <div id="customer-address" class="text-on-surface font-medium mt-1 leading-relaxed">Đang tải...</div>
                </div>

                <div>
                    <label class="text-xs text-on-surface-variant font-medium block uppercase tracking-wider">Ngày đặt hàng</label>
                    <div id="order-date" class="text-on-surface mt-1">Đang tải...</div>
                </div>
            </div>

            <!-- Quản lý trạng thái đơn hàng -->
            <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-6 space-y-4">
                <h3 class="font-headline text-lg font-semibold text-primary">Trạng thái đơn hàng</h3>
                
                <div class="flex items-center gap-2">
                    <span class="text-sm text-on-surface-variant">Hiện tại:</span>
                    <span id="current-status-badge"></span>
                </div>

                <div class="border-t border-outline-variant/25 pt-4 space-y-3">
                    <label for="status-select" class="text-xs font-semibold uppercase tracking-wider text-on-surface-variant block">Thay đổi trạng thái</label>
                    <select id="status-select" class="w-full px-3 py-2 border border-outline-variant/30 rounded-lg text-sm bg-white focus:outline-none focus:border-primary transition-colors">
                        <option value="Pending">Chờ xử lý (Pending)</option>
                        <option value="Confirmed">Đã xác nhận (Confirmed)</option>
                        <option value="Shipping">Đang giao hàng (Shipping)</option>
                        <option value="Completed">Hoàn thành (Completed)</option>
                        <option value="Cancelled">Đã hủy (Cancelled)</option>
                    </select>

                    <button id="btn-update-status" class="w-full bg-primary hover:bg-primary-container text-white font-medium py-2 rounded-lg text-sm shadow-sm hover:shadow transition-all duration-200 cursor-pointer">
                        Cập nhật trạng thái
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const orderId = @orderId;

        document.addEventListener("DOMContentLoaded", function () {
            fetchOrderDetails();
            document.getElementById("btn-update-status").addEventListener("click", updateOrderStatus);
            document.getElementById("btn-delete").addEventListener("click", deleteOrder);
        });

        async function fetchOrderDetails() {
            try {
                const response = await fetch(`/api/admin/orders/${orderId}`);
                if (!response.ok) {
                    if (response.status === 404) {
                        alert("Không tìm thấy đơn hàng!");
                    } else {
                        alert("Lỗi tải chi tiết đơn hàng.");
                    }
                    window.location.href = "/Admin/Order";
                    return;
                }

                const order = await response.json();

                // Điền thông tin giao hàng
                document.getElementById("customer-email").textContent = order.userEmail || "Khách vãng lai";
                document.getElementById("customer-phone").textContent = order.phoneNumber;
                document.getElementById("customer-address").textContent = order.shippingAddress;
                document.getElementById("order-date").textContent = new Date(order.orderDate).toLocaleString('vi-VN');

                // Hiển thị trạng thái hiện tại
                updateStatusBadge(order.status);
                document.getElementById("status-select").value = order.status;

                // Điền thông tin sản phẩm đã đặt
                const itemsTbody = document.getElementById("order-items-tbody");
                let itemsHtml = "";
                let subtotal = 0;

                order.orderDetails.forEach(item => {
                    const itemSubtotal = item.quantity * item.unitPrice;
                    subtotal += itemSubtotal;

                    const imgHtml = item.productImageUrl
                        ? `<img src="${item.productImageUrl}" alt="${item.productName}" class="w-full h-full object-cover" />`
                        : `<span class="material-symbols-outlined text-on-surface-variant/40">image</span>`;

                    const formattedUnitPrice = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.unitPrice);
                    const formattedSubtotal = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(itemSubtotal);

                    itemsHtml += `
                        <tr class="hover:bg-surface-variant/5 transition-colors">
                            <td class="py-4 px-6">
                                <div class="w-12 h-12 rounded overflow-hidden bg-surface-variant/20 border border-outline-variant/30 flex items-center justify-center">
                                    ${imgHtml}
                                </div>
                            </td>
                            <td class="py-4 px-6 font-medium text-on-surface">
                                <span class="block font-semibold">${item.productName}</span>
                                <span class="text-xs text-on-surface-variant">ID: #${item.productId}</span>
                            </td>
                            <td class="py-4 px-6 text-center text-on-surface-variant font-medium">${item.quantity}</td>
                            <td class="py-4 px-6 text-right text-on-surface-variant whitespace-nowrap">${formattedUnitPrice}</td>
                            <td class="py-4 px-6 text-right font-semibold text-primary whitespace-nowrap">${formattedSubtotal}</td>
                        </tr>
                    `;
                });

                itemsTbody.innerHTML = itemsHtml;

                // Điền tổng tiền mặt
                // Luật phí vận chuyển: Miễn phí cho đơn từ 5.000.000₫ trở lên, ngược lại tính 50.000₫
                const shippingFeeVal = subtotal >= 5000000 ? 0 : 50000;
                
                document.getElementById("subtotal-amount").textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(subtotal);
                document.getElementById("shipping-fee").textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(shippingFeeVal);
                document.getElementById("total-amount").textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(order.totalAmount);

                // Hiện UI và ẩn loading spinner
                document.getElementById("loading-container").classList.add("hidden");
                document.getElementById("order-details-content").classList.remove("hidden");
                document.getElementById("action-buttons-container").classList.remove("hidden");

                document.title = "Chi tiết đơn hàng #" + order.orderId;
            } catch (error) {
                console.error("Lỗi khi tải chi tiết đơn hàng:", error);
                alert("Đã xảy ra lỗi hệ thống khi tải thông tin đơn hàng.");
                window.location.href = "/Admin/Order";
            }
        }

        function updateStatusBadge(status) {
            const badgeEl = document.getElementById("current-status-badge");
            switch (status) {
                case "Pending":
                    badgeEl.className = "inline-flex items-center gap-1.5 bg-yellow-50 text-yellow-700 border border-yellow-200 text-xs px-2.5 py-0.5 rounded-full font-semibold";
                    badgeEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>Chờ xử lý`;
                    break;
                case "Confirmed":
                    badgeEl.className = "inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 border border-blue-200 text-xs px-2.5 py-0.5 rounded-full font-semibold";
                    badgeEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Đã xác nhận`;
                    break;
                case "Shipping":
                    badgeEl.className = "inline-flex items-center gap-1.5 bg-indigo-50 text-indigo-700 border border-indigo-200 text-xs px-2.5 py-0.5 rounded-full font-semibold";
                    badgeEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>Đang giao hàng`;
                    break;
                case "Completed":
                    badgeEl.className = "inline-flex items-center gap-1.5 bg-green-50 text-green-700 border border-green-200 text-xs px-2.5 py-0.5 rounded-full font-semibold";
                    badgeEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>Hoàn thành`;
                    break;
                case "Cancelled":
                    badgeEl.className = "inline-flex items-center gap-1.5 bg-red-50 text-red-700 border border-red-200 text-xs px-2.5 py-0.5 rounded-full font-semibold";
                    badgeEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>Đã hủy`;
                    break;
                default:
                    badgeEl.className = "inline-flex items-center gap-1.5 bg-gray-50 text-gray-700 border border-gray-200 text-xs px-2.5 py-0.5 rounded-full font-semibold";
                    badgeEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-gray-500"></span>${status}`;
            }
        }

        async function updateOrderStatus() {
            const newStatus = document.getElementById("status-select").value;
            const btn = document.getElementById("btn-update-status");

            btn.disabled = true;
            btn.textContent = "Đang cập nhật...";

            try {
                const response = await fetch(`/api/admin/orders/${orderId}/status`, {
                    method: "PUT",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ status: newStatus })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    alert("Cập nhật trạng thái đơn hàng thành công!");
                    updateStatusBadge(result.status);
                } else {
                    alert(`Lỗi khi cập nhật trạng thái: ${result.message || "Lỗi không xác định."}`);
                }
            } catch (error) {
                console.error("Lỗi cập nhật trạng thái:", error);
                alert("Đã xảy ra lỗi hệ thống khi cập nhật trạng thái đơn hàng.");
            } finally {
                btn.disabled = false;
                btn.textContent = "Cập nhật trạng thái";
            }
        }

        async function deleteOrder() {
            if (!confirm(`Bạn có chắc chắn muốn xóa đơn hàng #${orderId} không? Hành động này sẽ xóa vĩnh viễn đơn hàng khỏi cơ sở dữ liệu.`)) {
                return;
            }

            try {
                const response = await fetch(`/api/admin/orders/${orderId}`, {
                    method: "DELETE"
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    alert("Xóa đơn hàng thành công!");
                    window.location.href = "/Admin/Order";
                } else {
                    alert(`Không thể xóa đơn hàng: ${result.message || "Lỗi không xác định."}`);
                }
            } catch (error) {
                console.error("Lỗi khi xóa đơn hàng:", error);
                alert("Đã xảy ra lỗi hệ thống khi xóa đơn hàng.");
            }
        }
    </script>
}
