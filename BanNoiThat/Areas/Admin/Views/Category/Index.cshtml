@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="max-w-7xl mx-auto px-6 py-10">
    <partial name="_AdminNav" />

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div>
            <h1 class="font-headline text-3xl font-semibold text-primary">Quản lý danh mục</h1>
            <p class="text-on-surface-variant mt-1 text-sm">Quản lý các nhóm thể loại sản phẩm nội thất có trong hệ thống.</p>
        </div>
        <div>
            <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="inline-flex items-center gap-2 bg-primary text-white hover:bg-primary-container px-5 py-2.5 rounded-full font-medium shadow-sm hover:shadow transition-all duration-200">
                <span class="material-symbols-outlined text-[20px]">add</span>
                <span>Thêm danh mục mới</span>
            </a>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-secondary-container/30 border-b border-outline-variant/20 text-on-surface-variant text-xs font-semibold uppercase tracking-wider">
                        <th class="py-4 px-6">Hình ảnh</th>
                        <th class="py-4 px-6">ID</th>
                        <th class="py-4 px-6">Tên danh mục</th>
                        <th class="py-4 px-6">Mô tả</th>
                        <th class="py-4 px-6 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody id="category-table-body" class="divide-y divide-outline-variant/20 text-sm">
                    <tr>
                        <td colspan="5" class="py-10 px-6 text-center text-on-surface-variant">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <div class="w-6 h-6 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>
                                <span>Đang tải danh mục...</span>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            loadCategories();
        });

        async function loadCategories() {
            const tableBody = document.getElementById("category-table-body");
            try {
                const response = await fetch("/api/categories");
                if (!response.ok) throw new Error("Không thể tải danh sách danh mục.");
                
                const categories = await response.json();
                
                if (categories.length === 0) {
                    tableBody.innerHTML = `
                        <tr>
                            <td colspan="5" class="py-10 px-6 text-center text-on-surface-variant">
                                <span class="material-symbols-outlined text-4xl text-on-surface-variant/30 block mb-2">folder_open</span>
                                Chưa có danh mục nào. Hãy bấm "Thêm danh mục mới" để bắt đầu.
                            </td>
                        </tr>
                    `;
                    return;
                }

                let html = "";
                categories.forEach(item => {
                    const imgHtml = item.imageUrl 
                        ? `<img src="${item.imageUrl}" alt="${item.name}" class="w-full h-full object-cover" />`
                        : `<span class="material-symbols-outlined text-on-surface-variant/40 text-[20px]">folder</span>`;

                    html += `
                        <tr id="category-row-${item.categoryId}" class="hover:bg-surface-variant/10 transition-colors">
                            <td class="py-4 px-6">
                                <div class="w-12 h-12 rounded-lg overflow-hidden bg-surface-variant/20 border border-outline-variant/30 flex items-center justify-center">
                                    ${imgHtml}
                                </div>
                            </td>
                            <td class="py-4 px-6 text-on-surface-variant font-medium">#${item.categoryId}</td>
                            <td class="py-4 px-6 font-semibold text-primary text-base">${item.name}</td>
                            <td class="py-4 px-6 text-on-surface-variant max-w-md truncate">${item.description || ''}</td>
                            <td class="py-4 px-6">
                                <div class="flex items-center justify-center gap-3">
                                    <a href="/Admin/Category/Details/${item.categoryId}" class="text-on-surface-variant hover:text-primary p-1 rounded hover:bg-surface-variant/20 transition-colors" title="Xem chi tiết">
                                        <span class="material-symbols-outlined text-[20px]">visibility</span>
                                    </a>
                                    <a href="/Admin/Category/Edit/${item.categoryId}" class="text-primary hover:text-primary-container p-1 rounded hover:bg-surface-variant/20 transition-colors" title="Sửa">
                                        <span class="material-symbols-outlined text-[20px]">edit</span>
                                    </a>
                                    <button onclick="deleteCategory(${item.categoryId}, '${item.name}')" class="text-red-600 hover:text-red-500 p-1 rounded hover:bg-red-50 transition-colors cursor-pointer" title="Xóa">
                                        <span class="material-symbols-outlined text-[20px]">delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                });
                tableBody.innerHTML = html;
            } catch (error) {
                console.error(error);
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="5" class="py-10 px-6 text-center text-red-500 font-medium">
                            Đã xảy ra lỗi khi tải dữ liệu: ${error.message}
                        </td>
                    </tr>
                `;
            }
        }

        async function deleteCategory(id, name) {
            if (!confirm(`Bạn có chắc chắn muốn xóa danh mục "${name}" không?`)) {
                return;
            }

            try {
                const response = await fetch(`/api/categories/${id}`, {
                    method: "DELETE"
                });

                const result = await response.json();
                
                if (response.ok && result.success) {
                    alert("Xóa danh mục thành công!");
                    // Remove row from DOM
                    const row = document.getElementById(`category-row-${id}`);
                    if (row) row.remove();
                    
                    // Check if table is empty now
                    const tableBody = document.getElementById("category-table-body");
                    if (tableBody.children.length === 0) {
                        loadCategories(); // Reload to show "No categories" message
                    }
                } else {
                    alert(`Không thể xóa: ${result.message || "Lỗi không xác định."}`);
                }
            } catch (error) {
                console.error("Lỗi khi xóa danh mục:", error);
                alert("Đã xảy ra lỗi hệ thống khi xóa danh mục!");
            }
        }
    </script>
}
