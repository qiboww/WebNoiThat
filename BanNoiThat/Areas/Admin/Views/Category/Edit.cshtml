@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
    var categoryId = ViewBag.CategoryId;
}

<div class="max-w-2xl mx-auto px-6 py-10">
    <div class="mb-8">
        <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="inline-flex items-center gap-1.5 text-on-surface-variant hover:text-primary transition-colors text-sm font-medium mb-4">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Quay lại danh mục</span>
        </a>
        <h1 class="font-headline text-3xl font-semibold text-primary">Chỉnh sửa danh mục</h1>
        <p class="text-on-surface-variant mt-1 text-sm">Chỉnh sửa thông tin chi tiết danh mục sản phẩm nội thất bên dưới.</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-6 md:p-8">
        <!-- Loading indicator -->
        <div id="loading-container" class="py-10 text-center text-on-surface-variant">
            <div class="inline-block w-8 h-8 border-4 border-primary border-t-transparent rounded-full animate-spin mb-2"></div>
            <p>Đang tải thông tin danh mục...</p>
        </div>

        <form id="edit-category-form" class="space-y-6 hidden" novalidate>
            <!-- Hidden Fields -->
            <input type="hidden" id="CategoryId" name="CategoryId" value="@categoryId" />

            <!-- Tên danh mục -->
            <div>
                <label for="Name" class="block text-sm font-medium text-on-surface mb-2">Tên danh mục <span class="text-red-500">*</span></label>
                <input id="Name" name="Name" type="text" placeholder="Ví dụ: Ghế sofa, Bàn ăn, Đèn trang trí..." class="w-full px-4 py-2.5 rounded-lg border border-outline-variant focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 text-sm transition-all" required />
                <span id="error-Name" class="error-msg text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Mô tả danh mục -->
            <div>
                <label for="Description" class="block text-sm font-medium text-on-surface mb-2">Mô tả danh mục</label>
                <textarea id="Description" name="Description" rows="4" placeholder="Nhập mô tả tóm tắt về danh mục này..." class="w-full px-4 py-2.5 rounded-lg border border-outline-variant focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 text-sm transition-all resize-y"></textarea>
                <span id="error-Description" class="error-msg text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Ảnh hiện tại -->
            <div>
                <label class="block text-sm font-medium text-on-surface mb-2">Hình ảnh hiện tại</label>
                <div class="flex items-center gap-4">
                    <div id="current-image-container" class="w-20 h-20 rounded-lg overflow-hidden border border-outline-variant bg-surface-variant/20 flex items-center justify-center">
                        <span class="material-symbols-outlined text-on-surface-variant/30 text-3xl">folder</span>
                    </div>
                    <div class="text-xs text-on-surface-variant">
                        Nếu bạn không muốn thay đổi ảnh, vui lòng bỏ trống phần "Tải lên ảnh mới" bên dưới.
                    </div>
                </div>
            </div>

            <!-- Tải lên ảnh mới -->
            <div>
                <label for="imageFile" class="block text-sm font-medium text-on-surface mb-2">Tải lên ảnh mới</label>
                <input id="imageFile" name="imageFile" type="file" accept="image/*" class="w-full px-4 py-2 rounded-lg border border-outline-variant focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 text-sm bg-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-primary/10 file:text-primary hover:file:bg-primary/20 transition-all cursor-pointer" />
                <p class="text-xs text-on-surface-variant mt-1">Chọn file ảnh mới để thay đổi ảnh hiện tại của danh mục sản phẩm này.</p>
                <span id="error-imageFile" class="error-msg text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Các nút hành động -->
            <div class="flex items-center justify-end gap-4 pt-4 border-t border-outline-variant/30">
                <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="px-5 py-2.5 rounded-full border border-outline-variant hover:bg-surface-variant/25 font-medium text-sm text-on-surface transition-all">
                    Hủy bỏ
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-full bg-primary hover:bg-primary-container text-white font-medium text-sm shadow-sm hover:shadow transition-all">
                    Cập nhật danh mục
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const categoryId = @categoryId;

        document.addEventListener("DOMContentLoaded", function () {
            fetchCategoryData();
        });

        async function fetchCategoryData() {
            try {
                const response = await fetch(`/api/categories/${categoryId}`);
                if (!response.ok) {
                    if (response.status === 404) {
                        alert("Không tìm thấy danh mục này!");
                    } else {
                        alert("Lỗi tải thông tin danh mục.");
                    }
                    window.location.href = "/Admin/Category";
                    return;
                }

                const category = await response.json();

                // Populate fields
                document.getElementById("Name").value = category.name;
                document.getElementById("Description").value = category.description || "";
                
                // Show current image
                if (category.imageUrl) {
                    const imgContainer = document.getElementById("current-image-container");
                    imgContainer.innerHTML = `<img src="${category.imageUrl}" alt="${category.name}" class="w-full h-full object-cover" />`;
                }

                // Show form and hide loading
                document.getElementById("loading-container").classList.add("hidden");
                document.getElementById("edit-category-form").classList.remove("hidden");
                
                // Update title
                document.title = "Chỉnh sửa danh mục - " + category.name;
            } catch (error) {
                console.error("Lỗi khi tải thông tin danh mục:", error);
                alert("Đã xảy ra lỗi kết nối khi tải thông tin danh mục.");
                window.location.href = "/Admin/Category";
            }
        }

        document.getElementById("edit-category-form").addEventListener("submit", async function (e) {
            e.preventDefault();

            // Clear old error messages
            document.querySelectorAll(".error-msg").forEach(el => el.textContent = "");

            const form = e.target;
            const formData = new FormData(form);

            // Client-side quick check
            const nameInput = document.getElementById("Name");
            if (!nameInput.value.trim()) {
                document.getElementById("error-Name").textContent = "Tên danh mục là bắt buộc.";
                nameInput.focus();
                return;
            }

            try {
                const response = await fetch(`/api/categories/${categoryId}`, {
                    method: "PUT",
                    body: formData
                });

                if (response.ok) {
                    alert("Cập nhật danh mục thành công!");
                    window.location.href = "/Admin/Category";
                } else if (response.status === 400) {
                    const errData = await response.json();
                    if (errData.errors) {
                        for (const [key, messages] of Object.entries(errData.errors)) {
                            const errorSpan = document.getElementById(`error-${key}`);
                            if (errorSpan) {
                                errorSpan.textContent = messages.join(", ");
                            }
                        }
                    } else {
                        alert(errData.message || "Dữ liệu gửi lên không hợp lệ.");
                    }
                } else if (response.status === 401 || response.status === 403) {
                    alert("Bạn không có quyền thực hiện thao tác này. Vui lòng đăng nhập lại với tài khoản Admin.");
                } else {
                    const errText = await response.text();
                    alert("Lỗi máy chủ: " + (errText || response.statusText));
                }
            } catch (error) {
                console.error("Lỗi khi cập nhật danh mục:", error);
                alert("Đã xảy ra lỗi hệ thống khi kết nối tới máy chủ.");
            }
        });
    </script>
}
