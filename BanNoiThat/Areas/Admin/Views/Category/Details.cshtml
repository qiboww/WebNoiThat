@{
    ViewData["Title"] = "Chi tiết danh mục";
    var categoryId = ViewBag.CategoryId;
}

<div class="max-w-7xl mx-auto px-6 py-10">
    <!-- Header Page -->
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="inline-flex items-center gap-1.5 text-on-surface-variant hover:text-primary transition-colors text-sm font-medium mb-4">
                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                <span>Quay lại danh mục</span>
            </a>
            <h1 class="font-headline text-3xl font-semibold text-primary">Chi tiết danh mục</h1>
        </div>
        <div id="action-buttons-container" class="flex items-center gap-3 hidden">
            <a id="btn-edit" href="/Admin/Category/Edit/@categoryId" class="inline-flex items-center gap-1.5 border border-primary text-primary hover:bg-primary/5 px-5 py-2.5 rounded-full font-medium transition-all text-sm">
                <span class="material-symbols-outlined text-[18px]">edit</span>
                <span>Chỉnh sửa</span>
            </a>
            <button id="btn-delete" class="inline-flex items-center gap-1.5 bg-red-600 text-white hover:bg-red-500 px-5 py-2.5 rounded-full font-medium transition-all text-sm shadow-sm hover:shadow cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">delete</span>
                <span>Xóa danh mục</span>
            </button>
        </div>
    </div>

    <!-- Loading spinner -->
    <div id="loading-container" class="py-20 text-center text-on-surface-variant">
        <div class="inline-block w-8 h-8 border-4 border-primary border-t-transparent rounded-full animate-spin mb-2"></div>
        <p>Đang tải thông tin chi tiết danh mục...</p>
    </div>

    <div id="details-content" class="hidden">
        <!-- Thông tin chi tiết Danh mục -->
        <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-6 md:p-8 mb-10">
            <div class="flex flex-col md:flex-row gap-8 items-center md:items-start">
                <div id="category-image" class="w-32 h-32 rounded-xl overflow-hidden border border-outline-variant bg-surface-variant/20 flex items-center justify-center flex-shrink-0">
                    <span class="material-symbols-outlined text-on-surface-variant/30 text-5xl">folder</span>
                </div>
                <div class="space-y-3 flex-grow text-center md:text-left">
                    <h2 id="category-name" class="font-headline text-2xl font-semibold text-on-surface"></h2>
                    <div class="text-sm text-on-surface-variant font-medium">Mã danh mục: #@categoryId</div>
                    <p id="category-description" class="text-sm text-on-surface-variant leading-relaxed max-w-2xl"></p>
                </div>
            </div>
        </div>

        <!-- Danh sách sản phẩm trực thuộc -->
        <div>
            <h3 class="font-headline text-2xl font-semibold text-primary mb-6">Sản phẩm thuộc danh mục</h3>
            <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-secondary-container/30 border-b border-outline-variant/20 text-on-surface-variant text-xs font-semibold uppercase tracking-wider">
                                <th class="py-4 px-6">Hình ảnh</th>
                                <th class="py-4 px-6">Tên sản phẩm</th>
                                <th class="py-4 px-6 text-right">Giá bán</th>
                                <th class="py-4 px-6 text-center">Số lượng kho</th>
                                <th class="py-4 px-6">Chất liệu</th>
                            </tr>
                        </thead>
                        <tbody id="products-table-body" class="divide-y divide-outline-variant/20 text-sm">
                            <!-- Populated dynamically via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const categoryId = @categoryId;
        let categoryNameGlobal = "";

        document.addEventListener("DOMContentLoaded", function () {
            fetchCategoryDetails();
        });

        async function fetchCategoryDetails() {
            try {
                const response = await fetch(`/api/categories/${categoryId}/with-products`);
                if (!response.ok) {
                    if (response.status === 404) {
                        alert("Không tìm thấy danh mục này!");
                    } else {
                        alert("Lỗi tải thông tin chi tiết danh mục.");
                    }
                    window.location.href = "/Admin/Category";
                    return;
                }

                const category = await response.json();
                categoryNameGlobal = category.name;

                // Update text details
                document.getElementById("category-name").textContent = category.name;
                document.getElementById("category-description").textContent = category.description || "Không có mô tả cho danh mục này.";
                document.title = "Chi tiết danh mục - " + category.name;

                // Render image
                if (category.imageUrl) {
                    document.getElementById("category-image").innerHTML = `<img src="${category.imageUrl}" alt="${category.name}" class="w-full h-full object-cover" />`;
                }

                // Render products list
                const productsTableBody = document.getElementById("products-table-body");
                const products = category.products || [];
                
                if (products.length === 0) {
                    productsTableBody.innerHTML = `
                        <tr>
                            <td colspan="5" class="py-12 px-6 text-center text-on-surface-variant">
                                <span class="material-symbols-outlined text-4xl text-on-surface-variant/30 block mb-2">inventory_2</span>
                                Chưa có sản phẩm nào thuộc danh mục này.
                            </td>
                        </tr>
                    `;
                } else {
                    let html = "";
                    products.forEach(prod => {
                        const imgHtml = prod.imageUrl 
                            ? `<img src="${prod.imageUrl}" alt="${prod.name}" class="w-full h-full object-cover" />`
                            : `<span class="material-symbols-outlined text-on-surface-variant/40 text-[18px]">image</span>`;
                        
                        const formattedPrice = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(prod.price);
                        const stockStyle = prod.stockQuantity > 0 ? 'text-green-600' : 'text-red-500';

                        html += `
                            <tr class="hover:bg-surface-variant/10 transition-colors">
                                <td class="py-4 px-6">
                                    <div class="w-10 h-10 rounded overflow-hidden bg-surface-variant/20 border border-outline-variant/30 flex items-center justify-center">
                                        ${imgHtml}
                                    </div>
                                </td>
                                <td class="py-4 px-6 font-medium text-on-surface hover:text-primary transition-colors">
                                    <a href="/Admin/Product/Details/${prod.productId}">${prod.name}</a>
                                </td>
                                <td class="py-4 px-6 text-right font-semibold text-primary">${formattedPrice}</td>
                                <td class="py-4 px-6 text-center font-medium ${stockStyle}">
                                    ${prod.stockQuantity}
                                </td>
                                <td class="py-4 px-6 text-on-surface-variant">${prod.material || "Đang cập nhật"}</td>
                            </tr>
                        `;
                    });
                    productsTableBody.innerHTML = html;
                }

                // Show content and buttons, hide loading
                document.getElementById("loading-container").classList.add("hidden");
                document.getElementById("details-content").classList.remove("hidden");
                document.getElementById("action-buttons-container").classList.remove("hidden");

                // Bind delete button
                document.getElementById("btn-delete").addEventListener("click", deleteCategory);

            } catch (error) {
                console.error("Lỗi khi tải chi tiết danh mục:", error);
                alert("Đã xảy ra lỗi hệ thống khi tải thông tin danh mục.");
                window.location.href = "/Admin/Category";
            }
        }

        async function deleteCategory() {
            if (!confirm(`Bạn có chắc chắn muốn xóa danh mục "${categoryNameGlobal}" không?`)) {
                return;
            }

            try {
                const response = await fetch(`/api/categories/${categoryId}`, {
                    method: "DELETE"
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    alert("Xóa danh mục thành công!");
                    window.location.href = "/Admin/Category";
                } else {
                    alert(`Không thể xóa danh mục: ${result.message || "Lỗi không xác định."}`);
                }
            } catch (error) {
                console.error("Lỗi khi xóa danh mục:", error);
                alert("Đã xảy ra lỗi hệ thống khi xóa danh mục.");
            }
        }
    </script>
}
