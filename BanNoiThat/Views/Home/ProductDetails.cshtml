@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    var productId = ViewBag.ProductId;
}

<div class="max-w-6xl mx-auto px-6 py-12">
    <!-- Nút quay lại -->
    <div class="mb-6">
        <a href="/Home/Products" class="inline-flex items-center gap-1.5 text-on-surface-variant hover:text-primary transition-colors text-sm font-medium">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Quay lại cửa hàng</span>
        </a>
    </div>

    <!-- Loading spinner -->
    <div id="loading-container" class="py-20 text-center text-on-surface-variant">
        <div class="inline-block w-8 h-8 border-4 border-primary border-t-transparent rounded-full animate-spin mb-2"></div>
        <p>Đang tải chi tiết sản phẩm...</p>
    </div>

    <div id="details-card" class="bg-white rounded-2xl shadow-sm border border-outline-variant/20 overflow-hidden p-6 md:p-10 hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <!-- Hình ảnh sản phẩm / Trình xem 3D (bên trái) -->
            <div class="aspect-square w-full rounded-xl overflow-hidden bg-surface-variant/20 border border-outline-variant/30 flex items-center justify-center relative group">
                
                <!-- Chuyển đổi chế độ xem -->
                <div id="view-toggle-container" class="absolute top-4 right-4 z-10 flex bg-white/90 backdrop-blur border border-outline-variant/40 rounded-full p-1 shadow-sm transition-all duration-200 opacity-90 group-hover:opacity-100 hidden">
                    <button id="btn-view-2d" class="px-3.5 py-1.5 rounded-full text-xs font-semibold flex items-center gap-1 bg-primary text-white transition-all shadow-sm cursor-pointer">
                        <span class="material-symbols-outlined text-[16px]">image</span>
                        <span>Ảnh 2D</span>
                    </button>
                    <button id="btn-view-3d" class="px-3.5 py-1.5 rounded-full text-xs font-semibold flex items-center gap-1 text-on-surface-variant hover:text-primary transition-all cursor-pointer">
                        <span class="material-symbols-outlined text-[16px]">view_in_ar</span>
                        <span>Mô hình 3D</span>
                    </button>
                </div>

                <!-- Chế độ xem ảnh 2D -->
                <div id="container-2d" class="w-full h-full">
                    <div class="flex flex-col items-center justify-center text-on-surface-variant/30 h-full">
                        <span class="material-symbols-outlined text-8xl block mb-2">image</span>
                        <span class="text-sm">Đang tải hình ảnh...</span>
                    </div>
                </div>

                <!-- Chế độ xem mô hình 3D -->
                <div id="container-3d" class="w-full h-full hidden">
                    <!-- Populated dynamically via JS -->
                </div>
            </div>

            <!-- Thông tin chi tiết (bên phải) -->
            <div class="flex flex-col justify-between h-full space-y-8">
                <div class="space-y-6">
                    <div>
                        <span id="product-category" class="bg-secondary-container text-primary text-xs px-3 py-1.5 rounded-full font-semibold uppercase tracking-wider">
                            Nội thất
                        </span>
                        <h1 id="product-name" class="font-headline text-3xl md:text-4xl font-semibold text-on-surface mt-3"></h1>
                    </div>

                    <div class="border-t border-b border-outline-variant/20 py-5">
                        <div class="text-xs text-on-surface-variant uppercase tracking-wider font-semibold">Giá bán lẻ</div>
                        <div id="product-price" class="text-4xl font-semibold text-primary mt-1">0₫</div>
                    </div>

                    <!-- Thông số phụ -->
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div class="bg-surface-variant/10 p-4 rounded-xl border border-outline-variant/20">
                            <div class="text-xs text-on-surface-variant font-medium">Chất liệu chính</div>
                            <div id="product-material" class="text-on-surface font-semibold mt-1">Đang cập nhật</div>
                        </div>
                        <div class="bg-surface-variant/10 p-4 rounded-xl border border-outline-variant/20">
                            <div class="text-xs text-on-surface-variant font-medium">Tình trạng kho</div>
                            <div id="product-stock" class="font-semibold mt-1">
                                Đang kiểm tra...
                            </div>
                        </div>
                    </div>

                    <!-- Mô tả sản phẩm -->
                    <div class="space-y-2.5">
                        <h3 class="text-sm font-semibold text-on-surface uppercase tracking-wider">Mô tả sản phẩm</h3>
                        <p id="product-description" class="text-sm text-on-surface-variant leading-relaxed whitespace-pre-wrap">Hiện chưa có thông tin mô tả chi tiết cho sản phẩm này.</p>
                    </div>
                </div>

                <!-- Nút Thêm vào giỏ -->
                <div id="cart-button-container" class="pt-6 border-t border-outline-variant/20">
                    <button class="w-full bg-primary hover:bg-primary-container text-white py-3 px-6 rounded-full font-semibold shadow hover:shadow-md transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer">
                        <span class="material-symbols-outlined">shopping_cart</span>
                        <span>Thêm vào giỏ hàng</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const productId = @productId;
        let is3DLoaded = false;
        let modelViewerScriptLoaded = false;

        document.addEventListener("DOMContentLoaded", function () {
            fetchProductDetails();
        });

        async function fetchProductDetails() {
            try {
                const response = await fetch(`/api/products/${productId}`);
                if (!response.ok) {
                    if (response.status === 404) {
                        alert("Không tìm thấy sản phẩm này!");
                    } else {
                        alert("Lỗi khi tải chi tiết sản phẩm.");
                    }
                    window.location.href = "/Home/Products";
                    return;
                }

                const product = await response.json();

                // Populate Text Details
                document.getElementById("product-name").textContent = product.name;
                document.getElementById("product-category").textContent = product.category ? product.category.name : "Nội thất";
                
                const formattedPrice = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(product.price);
                document.getElementById("product-price").textContent = formattedPrice;
                
                document.getElementById("product-material").textContent = product.material || "Đang cập nhật";
                
                // Stock status
                const stockEl = document.getElementById("product-stock");
                const cartContainer = document.getElementById("cart-button-container");
                if (product.stockQuantity > 0) {
                    stockEl.className = "font-semibold mt-1 text-green-600";
                    stockEl.textContent = `Còn hàng (${product.stockQuantity} chiếc)`;
                    cartContainer.innerHTML = `
                        <button class="w-full bg-primary hover:bg-primary-container text-white py-3 px-6 rounded-full font-semibold shadow hover:shadow-md transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer">
                            <span class="material-symbols-outlined">shopping_cart</span>
                            <span>Thêm vào giỏ hàng</span>
                        </button>
                    `;
                } else {
                    stockEl.className = "font-semibold mt-1 text-red-500";
                    stockEl.textContent = "Hết hàng";
                    cartContainer.innerHTML = `
                        <button disabled class="w-full bg-on-surface-variant/20 text-on-surface-variant/60 py-3 px-6 rounded-full font-semibold cursor-not-allowed flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined">inventory_2</span>
                            <span>Sản phẩm tạm hết hàng</span>
                        </button>
                    `;
                }

                document.getElementById("product-description").textContent = product.description || "Hiện chưa có thông tin mô tả chi tiết cho sản phẩm này từ DecorHome.";

                // Render 2D Image
                const container2d = document.getElementById("container-2d");
                if (product.imageUrl) {
                    container2d.innerHTML = `<img src="${product.imageUrl}" alt="${product.name}" class="w-full h-full object-cover" />`;
                } else {
                    container2d.innerHTML = `
                        <div class="flex flex-col items-center justify-center text-on-surface-variant/30 h-full">
                            <span class="material-symbols-outlined text-8xl block mb-2">image</span>
                            <span class="text-sm">Chưa cập nhật hình ảnh</span>
                        </div>
                    `;
                }

                // Handle 3D View option
                if (product.model3DUrl) {
                    document.getElementById("view-toggle-container").classList.remove("hidden");
                    setupViewToggles(product.model3DUrl, product.name);
                }

                // Hide loading, show details card
                document.getElementById("loading-container").classList.add("hidden");
                document.getElementById("details-card").classList.remove("hidden");

                document.title = product.name + " - DecorHome";
            } catch (error) {
                console.error("Lỗi tải chi tiết sản phẩm:", error);
                alert("Đã xảy ra lỗi kết nối khi tải chi tiết sản phẩm.");
                window.location.href = "/Home/Products";
            }
        }

        function setupViewToggles(model3DUrl, productName) {
            const btn2d = document.getElementById("btn-view-2d");
            const btn3d = document.getElementById("btn-view-3d");
            const container2d = document.getElementById("container-2d");
            const container3d = document.getElementById("container-3d");

            btn2d.addEventListener("click", () => {
                btn2d.classList.add("bg-primary", "text-white", "shadow-sm");
                btn2d.classList.remove("text-on-surface-variant", "hover:text-primary");
                
                btn3d.classList.remove("bg-primary", "text-white", "shadow-sm");
                btn3d.classList.add("text-on-surface-variant", "hover:text-primary");
                
                container2d.classList.remove("hidden");
                container3d.classList.add("hidden");
            });

            btn3d.addEventListener("click", () => {
                btn3d.classList.add("bg-primary", "text-white", "shadow-sm");
                btn3d.classList.remove("text-on-surface-variant", "hover:text-primary");
                
                btn2d.classList.remove("bg-primary", "text-white", "shadow-sm");
                btn2d.classList.add("text-on-surface-variant", "hover:text-primary");
                
                container3d.classList.remove("hidden");
                container2d.classList.add("hidden");

                // Lazy load the model-viewer element and script if not loaded yet
                if (!is3DLoaded) {
                    lazyLoad3DModel(model3DUrl, productName);
                }
            });
        }

        function lazyLoad3DModel(url, name) {
            // 1. Inject script if not loaded
            if (!modelViewerScriptLoaded) {
                const script = document.createElement("script");
                script.type = "module";
                script.src = "https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js";
                document.body.appendChild(script);
                modelViewerScriptLoaded = true;
            }

            // 2. Set up model-viewer tag
            const container3d = document.getElementById("container-3d");
            container3d.innerHTML = `
                <model-viewer src="${url}"
                              alt="Mô hình 3D của ${name}"
                              camera-controls
                              auto-rotate
                              ar
                              shadow-intensity="1"
                              touch-action="pan-y"
                              class="w-full h-full bg-transparent"
                              style="width: 100%; height: 100%;">
                </model-viewer>
            `;
            is3DLoaded = true;
        }
    </script>
}
