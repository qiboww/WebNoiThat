@{
    ViewData["Title"] = "Sản phẩm";
    var selectedCategoryId = ViewBag.SelectedCategoryId;
}

<div class="max-w-7xl mx-auto px-6 py-12">
    <!-- Header của trang -->
    <div class="text-center max-w-xl mx-auto mb-12">
        <h1 class="font-headline text-4xl font-semibold text-primary">Bộ sưu tập nội thất</h1>
        <div class="h-0.5 w-12 bg-primary mx-auto mt-4 rounded"></div>
        <p class="text-on-surface-variant mt-4 text-sm">
            <span id="catalog-subtitle">Khám phá toàn bộ sản phẩm thiết kế tối giản, tinh tế mang phong cách Bắc Âu.</span>
        </p>
    </div>

    <div class="flex flex-col lg:flex-row gap-10">
        <!-- Sidebar lọc danh mục (bên trái) -->
        <aside class="w-full lg:w-64 flex-shrink-0 space-y-6">
            <div class="border border-outline-variant/35 rounded-xl bg-white p-6">
                <h3 class="font-headline text-lg font-semibold text-primary mb-4 pb-2 border-b border-outline-variant/20">
                    Danh mục
                </h3>
                <ul id="categories-list" class="space-y-2 text-sm">
                    <!-- Loading Indicator -->
                    <li class="py-2 text-center text-xs text-on-surface-variant">Đang tải...</li>
                </ul>
            </div>
        </aside>

        <!-- Lưới danh sách sản phẩm (bên phải) -->
        <main class="flex-grow">
            <div id="products-loading" class="text-center py-20 bg-white rounded-xl border border-outline-variant/30 text-on-surface-variant/60">
                <div class="inline-block w-8 h-8 border-4 border-primary border-t-transparent rounded-full animate-spin mb-3"></div>
                <p class="text-sm">Đang tải sản phẩm...</p>
            </div>

            <div id="products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 hidden">
                <!-- Populated dynamically -->
            </div>

            <div id="products-empty" class="text-center py-20 bg-white rounded-xl border border-outline-variant/30 text-on-surface-variant/60 hidden">
                <span class="material-symbols-outlined text-6xl block mb-4 text-on-surface-variant/30">inventory_2</span>
                <h3 class="text-lg font-semibold text-on-surface mb-1">Chưa có sản phẩm nào</h3>
                <p class="text-sm">Không tìm thấy sản phẩm nào trong danh mục này.</p>
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <script>
        // Set initial selected category from server ViewBag or parse URL query
        let currentCategoryId = @(selectedCategoryId != null ? selectedCategoryId.ToString() : "null");

        document.addEventListener("DOMContentLoaded", async function () {
            // Read query param on load if viewbag is null
            if (currentCategoryId === null) {
                const urlParams = new URLSearchParams(window.location.search);
                const catIdParam = urlParams.get('categoryId');
                if (catIdParam) {
                    currentCategoryId = parseInt(catIdParam);
                }
            }

            await loadSidebarCategories();
            await loadProducts(currentCategoryId);

            // Handle browser back/forward buttons
            window.addEventListener('popstate', function () {
                const urlParams = new URLSearchParams(window.location.search);
                const catId = urlParams.get('categoryId') ? parseInt(urlParams.get('categoryId')) : null;
                currentCategoryId = catId;
                highlightActiveCategory(catId);
                loadProducts(catId, false); // Don't pushState again
            });
        });

        async function loadSidebarCategories() {
            const listContainer = document.getElementById("categories-list");
            try {
                const response = await fetch("/api/categories");
                if (!response.ok) throw new Error("Lỗi tải danh mục.");
                
                const categories = await response.json();

                const allActiveStyle = currentCategoryId === null 
                    ? "bg-primary text-white font-medium shadow-sm" 
                    : "text-on-surface-variant hover:bg-surface-variant/20 hover:text-primary";

                let html = `
                    <li>
                        <button onclick="filterCategory(null)" id="btn-cat-all" 
                           class="w-full flex items-center justify-between px-3 py-2 rounded-lg transition-colors text-left ${allActiveStyle} cursor-pointer">
                            <span>Tất cả sản phẩm</span>
                            <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                        </button>
                    </li>
                `;

                categories.forEach(cat => {
                    const activeStyle = currentCategoryId === cat.categoryId
                        ? "bg-primary text-white font-medium shadow-sm"
                        : "text-on-surface-variant hover:bg-surface-variant/20 hover:text-primary";

                    html += `
                        <li>
                            <button onclick="filterCategory(${cat.categoryId})" id="btn-cat-${cat.categoryId}" 
                               class="w-full flex items-center justify-between px-3 py-2 rounded-lg transition-colors text-left ${activeStyle} cursor-pointer">
                                <span>${cat.name}</span>
                                <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                            </button>
                        </li>
                    `;
                });
                
                listContainer.innerHTML = html;
            } catch (error) {
                console.error("Lỗi tải danh mục sidebar:", error);
                listContainer.innerHTML = '<li class="py-2 text-center text-xs text-red-500">Lỗi tải danh mục</li>';
            }
        }

        function highlightActiveCategory(categoryId) {
            // Reset all buttons
            document.querySelectorAll("#categories-list button").forEach(btn => {
                btn.className = "w-full flex items-center justify-between px-3 py-2 rounded-lg transition-colors text-left text-on-surface-variant hover:bg-surface-variant/20 hover:text-primary cursor-pointer";
            });

            // Set active button
            const activeBtnId = categoryId === null ? "btn-cat-all" : `btn-cat-${categoryId}`;
            const activeBtn = document.getElementById(activeBtnId);
            if (activeBtn) {
                activeBtn.className = "w-full flex items-center justify-between px-3 py-2 rounded-lg transition-colors text-left bg-primary text-white font-medium shadow-sm cursor-pointer";
            }
        }

        async function filterCategory(categoryId) {
            currentCategoryId = categoryId;
            highlightActiveCategory(categoryId);
            
            // Update URL parameter without reload
            const newUrl = categoryId === null ? "/Home/Products" : `/Home/Products?categoryId=${categoryId}`;
            window.history.pushState({ categoryId: categoryId }, '', newUrl);
            
            await loadProducts(categoryId);
        }

        async function loadProducts(categoryId, updateSubtitle = true) {
            const loadingContainer = document.getElementById("products-loading");
            const gridContainer = document.getElementById("products-grid");
            const emptyContainer = document.getElementById("products-empty");

            // Show loading, hide others
            loadingContainer.classList.remove("hidden");
            gridContainer.classList.add("hidden");
            emptyContainer.classList.add("hidden");

            try {
                let url = "/api/products";
                if (categoryId !== null) {
                    url += `?categoryId=${categoryId}`;
                }

                const response = await fetch(url);
                if (!response.ok) throw new Error("Lỗi tải sản phẩm.");

                const products = await response.json();

                // Update subtitle with category name
                if (updateSubtitle) {
                    const subtitleEl = document.getElementById("catalog-subtitle");
                    if (categoryId === null) {
                        subtitleEl.innerHTML = "Khám phá toàn bộ sản phẩm thiết kế tối giản, tinh tế mang phong cách Bắc Âu.";
                    } else {
                        // Find category name from selected button
                        const activeBtn = document.getElementById(`btn-cat-${categoryId}`);
                        const catName = activeBtn ? activeBtn.querySelector("span").textContent : "Danh mục";
                        subtitleEl.innerHTML = `Khám phá các sản phẩm độc đáo thuộc danh mục <strong>${catName}</strong> của chúng tôi.`;
                    }
                }

                // Hide loading
                loadingContainer.classList.add("hidden");

                if (products.length === 0) {
                    emptyContainer.classList.remove("hidden");
                    return;
                }

                let html = "";
                products.forEach(item => {
                    const imgHtml = item.imageUrl
                        ? `<img src="${item.imageUrl}" alt="${item.name}" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />`
                        : `<div class="w-full h-full flex items-center justify-center text-on-surface-variant/30"><span class="material-symbols-outlined text-5xl">image</span></div>`;

                    const formattedPrice = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.price);
                    const catName = item.category ? item.category.name : "Nội thất";
                    const materialText = item.material || "Đang cập nhật";

                    html += `
                        <div class="group bg-white rounded-xl shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden border border-outline-variant/20 flex flex-col h-full">
                            <!-- Ảnh sản phẩm -->
                            <a href="/Home/ProductDetails/${item.productId}" class="aspect-square w-full overflow-hidden bg-surface-variant/20 relative block">
                                ${imgHtml}
                            </a>

                            <!-- Thông tin sản phẩm -->
                            <div class="p-5 flex flex-col flex-grow">
                                <div class="text-[10px] text-primary font-semibold uppercase tracking-wider mb-1">
                                    ${catName}
                                </div>
                                <h3 class="font-headline text-lg font-semibold text-on-surface mb-1 hover:text-primary transition-colors">
                                    <a href="/Home/ProductDetails/${item.productId}">${item.name}</a>
                                </h3>
                                <div class="text-xs text-on-surface-variant mb-4 font-medium">Chất liệu: ${materialText}</div>
                                
                                <div class="flex items-center justify-between mt-auto pt-4 border-t border-outline-variant/20">
                                    <div class="font-semibold text-primary text-lg">${formattedPrice}</div>
                                    <a href="/Home/ProductDetails/${item.productId}" class="text-xs font-semibold text-primary hover:text-primary-container inline-flex items-center gap-0.5 border border-primary/25 rounded-full px-3.5 py-1.5 hover:bg-primary/5 transition-all">
                                        <span>Xem chi tiết</span>
                                        <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    `;
                });

                gridContainer.innerHTML = html;
                gridContainer.classList.remove("hidden");
            } catch (error) {
                console.error("Lỗi khi tải danh sách sản phẩm:", error);
                loadingContainer.classList.add("hidden");
                emptyContainer.classList.remove("hidden");
                emptyContainer.innerHTML = `
                    <span class="material-symbols-outlined text-6xl block mb-4 text-red-500/50">error</span>
                    <h3 class="text-lg font-semibold text-red-500 mb-1">Đã xảy ra lỗi</h3>
                    <p class="text-sm">Không thể kết nối tới máy chủ để tải danh sách sản phẩm.</p>
                `;
            }
        }
    </script>
}
