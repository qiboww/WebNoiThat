@{
    ViewData["Title"] = "Lịch sử mua hàng";
}

<div class="max-w-4xl mx-auto px-6 py-12">
    <!-- Header của trang -->
    <div class="mb-10 flex items-center justify-between border-b border-outline-variant/30 pb-6">
        <div>
            <h1 class="font-headline text-3xl md:text-4xl font-semibold text-primary">Lịch sử mua hàng</h1>
            <p class="text-on-surface-variant text-sm mt-1">Theo dõi trạng thái và thông tin các đơn hàng đã đặt của bạn.</p>
        </div>
        <a href="/Home/Products" class="inline-flex items-center gap-1.5 text-primary hover:text-primary-container text-sm font-semibold transition-all">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Quay lại cửa hàng</span>
        </a>
    </div>

    <!-- Loading spinner -->
    <div id="loading-container" class="py-20 text-center text-on-surface-variant">
        <div class="inline-block w-8 h-8 border-4 border-primary border-t-transparent rounded-full animate-spin mb-2"></div>
        <p class="text-sm">Đang tải lịch sử đơn hàng...</p>
    </div>

    <!-- Danh sách đơn hàng -->
    <div id="orders-list-container" class="space-y-8 hidden">
        <!-- Renders dynamically from JS -->
    </div>

    <!-- Thông báo khi chưa có đơn hàng -->
    <div id="orders-empty" class="hidden text-center py-20 bg-white rounded-2xl border border-outline-variant/20 shadow-sm max-w-lg mx-auto">
        <span class="material-symbols-outlined text-7xl text-on-surface-variant/30 block mb-4">shopping_bag</span>
        <h2 class="text-2xl font-semibold text-on-surface mb-2">Bạn chưa có đơn hàng nào</h2>
        <p class="text-on-surface-variant text-sm max-w-sm mx-auto mb-8">Hãy chọn những món đồ nội thất yêu thích để trang trí cho căn nhà của bạn nhé.</p>
        <a href="/Home/Products" class="bg-primary hover:bg-primary-container text-white px-8 py-3 rounded-full font-semibold shadow hover:shadow-md transition-all inline-flex items-center gap-1">
            <span>Khám phá sản phẩm</span>
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            loadOrderHistory();
        });

        async function loadOrderHistory() {
            const loading = document.getElementById("loading-container");
            const listContainer = document.getElementById("orders-list-container");
            const emptyContainer = document.getElementById("orders-empty");

            try {
                const response = await fetch("/api/orders/my-orders");
                if (!response.ok) {
                    throw new Error("Lỗi tải thông tin đơn hàng từ máy chủ.");
                }

                const orders = await response.json();

                if (orders.length === 0) {
                    loading.classList.add("hidden");
                    emptyContainer.classList.remove("hidden");
                    return;
                }

                let html = "";
                orders.forEach(order => {
                    const orderDate = new Date(order.orderDate).toLocaleString('vi-VN');
                    const formattedTotal = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(order.totalAmount);
                    
                    // Render items list inside order
                    let itemsHtml = "";
                    order.orderDetails.forEach(item => {
                        const itemSubtotal = item.quantity * item.unitPrice;
                        const formattedSubtotal = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(itemSubtotal);
                        const imgHtml = item.productImageUrl
                            ? `<img src="${item.productImageUrl}" alt="${item.productName}" class="w-full h-full object-cover" />`
                            : `<span class="material-symbols-outlined text-on-surface-variant/40">image</span>`;

                        itemsHtml += `
                            <div class="flex items-center gap-4 py-3 border-b border-outline-variant/10 last:border-b-0">
                                <div class="w-12 h-12 rounded overflow-hidden bg-surface-variant/10 border border-outline-variant/20 flex items-center justify-center flex-shrink-0">
                                    ${imgHtml}
                                </div>
                                <div class="flex-grow min-w-0">
                                    <h5 class="font-semibold text-on-surface text-sm truncate">${item.productName}</h5>
                                    <p class="text-xs text-on-surface-variant">Số lượng: ${item.quantity} x ${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.unitPrice)}</p>
                                </div>
                                <div class="font-semibold text-primary text-sm flex-shrink-0">
                                    ${formattedSubtotal}
                                </div>
                            </div>
                        `;
                    });

                    html += `
                        <div class="bg-white rounded-2xl border border-outline-variant/20 shadow-sm overflow-hidden p-6 space-y-5">
                            <!-- Header đơn hàng -->
                            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-outline-variant/15 pb-4 gap-3">
                                <div class="space-y-1">
                                    <h4 class="font-headline text-lg font-semibold text-primary">Mã đơn hàng: #${order.orderId}</h4>
                                    <p class="text-xs text-on-surface-variant">Đặt ngày: ${orderDate}</p>
                                </div>
                                <div class="flex items-center gap-2">
                                    ${getStatusBadge(order.status)}
                                </div>
                            </div>

                            <!-- Danh sách sản phẩm -->
                            <div class="divide-y divide-outline-variant/10">
                                ${itemsHtml}
                            </div>

                            <!-- Footer đơn hàng: Thông tin ship và Tổng tiền -->
                            <div class="bg-background/40 rounded-xl p-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4 border border-outline-variant/10">
                                <div class="text-xs space-y-1 text-on-surface-variant leading-relaxed">
                                    <p class="font-semibold text-on-surface uppercase tracking-wider text-[10px]">Thông tin nhận hàng</p>
                                    <p><strong class="font-semibold text-on-surface">Điện thoại:</strong> ${order.phoneNumber}</p>
                                    <p><strong class="font-semibold text-on-surface">Địa chỉ:</strong> ${order.shippingAddress}</p>
                                </div>
                                <div class="text-right flex-shrink-0 border-t md:border-t-0 md:border-l border-outline-variant/15 pt-3 md:pt-0 md:pl-6 flex flex-col justify-center">
                                    <span class="text-xs text-on-surface-variant">Tổng tiền thanh toán</span>
                                    <span class="text-xl font-bold text-primary mt-0.5">${formattedTotal}</span>
                                </div>
                            </div>
                        </div>
                    `;
                });

                listContainer.innerHTML = html;
                loading.classList.add("hidden");
                listContainer.classList.remove("hidden");

            } catch (error) {
                console.error("Lỗi khi tải lịch sử đơn hàng:", error);
                loading.innerHTML = `
                    <span class="material-symbols-outlined text-4xl text-red-500 mb-2">error</span>
                    <p class="text-red-500 font-medium">${error.message}</p>
                `;
            }
        }

        function getStatusBadge(status) {
            switch (status) {
                case "Pending":
                    return `<span class="inline-flex items-center gap-1.5 bg-yellow-50 text-yellow-700 border border-yellow-200 text-xs px-2.5 py-0.5 rounded-full font-semibold">
                             <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>
                             Chờ xử lý
                           </span>`;
                case "Confirmed":
                    return `<span class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 border border-blue-200 text-xs px-2.5 py-0.5 rounded-full font-semibold">
                             <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                             Đã xác nhận
                           </span>`;
                case "Shipping":
                    return `<span class="inline-flex items-center gap-1.5 bg-indigo-50 text-indigo-700 border border-indigo-200 text-xs px-2.5 py-0.5 rounded-full font-semibold">
                             <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
                             Đang giao
                           </span>`;
                case "Completed":
                    return `<span class="inline-flex items-center gap-1.5 bg-green-50 text-green-700 border border-green-200 text-xs px-2.5 py-0.5 rounded-full font-semibold">
                             <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                             Hoàn thành
                           </span>`;
                case "Cancelled":
                    return `<span class="inline-flex items-center gap-1.5 bg-red-50 text-red-700 border border-red-200 text-xs px-2.5 py-0.5 rounded-full font-semibold">
                             <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>
                             Đã hủy
                           </span>`;
                default:
                    return `<span class="inline-flex items-center gap-1.5 bg-gray-50 text-gray-700 border border-gray-200 text-xs px-2.5 py-0.5 rounded-full font-semibold">
                             <span class="w-1.5 h-1.5 rounded-full bg-gray-500"></span>
                             ${status}
                           </span>`;
            }
        }
    </script>
}
